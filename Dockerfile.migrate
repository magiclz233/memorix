# 数据库迁移镜像：运行镜像里没有 drizzle-kit，NAS 上又没有 shell，
# 所以单独做一个一次性迁移镜像（compose 的 migrate 服务用，跑完即退出）
FROM node:22-alpine
WORKDIR /app

RUN npm install --no-audit --no-fund drizzle-kit@0.31.8 drizzle-orm@0.45.1 postgres@3.4.6

COPY drizzle ./drizzle
COPY drizzle.migrate.config.mjs ./drizzle.migrate.config.mjs

CMD ["npx", "drizzle-kit", "migrate", "--config=drizzle.migrate.config.mjs"]
